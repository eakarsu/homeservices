  paymentId   String
  amountCents Int
  reason      String
  providerId  String?  @unique
  status      String   @default("PENDING")
  requestKey  String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([companyId, requestKey])
}

model WorkflowMutation {
