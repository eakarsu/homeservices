# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/home_services_ai"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://app.example.com"
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Authoritative estimate template hosts (hostnames only, comma-separated)
TEMPLATE_ALLOWED_HOSTS="templates.example.com"

# Google OAuth (optional - for "Sign in with Google")
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (optional - for "Sign in with Microsoft")
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# Google Maps
GOOGLE_MAPS_API_KEY="..."

# AI (OpenRouter - supports multiple models)
OPENROUTER_API_KEY="sk-or-..."
AI_MODEL="openai/gpt-4-turbo"  # or "anthropic/claude-3-opus", "google/gemini-pro", etc.

# OpenAI (fallback if OpenRouter not configured)
OPENAI_API_KEY="sk-..."

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # Same as above, exposed to client
STRIPE_WEBHOOK_SECRET="whsec_..."  # Get from Stripe Dashboard > Webhooks

# Twilio (for SMS/Voice)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# HTTPS email delivery provider (credentials are never logged)
EMAIL_DELIVERY_URL="https://email-provider.example.com/v1/send"
EMAIL_DELIVERY_ALLOWED_HOSTS="email-provider.example.com"
EMAIL_DELIVERY_TOKEN=""
EMAIL_FROM="ServiceCrew <service@example.com>"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ===========================================
# SEO & Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL="https://servicecrewai.com"

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-code"

# ===========================================
# SSL/Domain Configuration (Production Docker)
# ===========================================
DOMAIN="servicecrewai.com"
EMAIL="admin@servicecrewai.com"
ENABLE_SSL="true"
